# Port the server listens on (3001 in dev, 3000 in the container)
PORT=3000

# CTA API keys. These are two SEPARATE keys with separate quotas.
#   Train Tracker: https://www.transitchicago.com/developers/traintrackerapply/
#   Bus Tracker:   https://www.transitchicago.com/developers/bustracker/
CTA_TRAIN_API_KEY=
CTA_BUS_API_KEY=

# Metra GTFS API key. Apply at https://metra.com/metra-gtfs-api. Used to fetch
# Metra's published GTFS static schedule (stations, lines, scheduled times).
# Metra cards only ever show scheduled times, not live predictions.
METRA_API_KEY=

# Optional. Create one under Server Settings > Integrations > Webhooks in Discord.
# Leave blank to run the dashboard with digests disabled.
DISCORD_WEBHOOK_URL=

# Where config.json and stations.json live. Mounted as a volume in Docker.
DATA_DIR=./data

# Set to 1 to serve fixture data instead of calling the CTA. No API keys needed.
CTA_MOCK=0
